{
  // Runtime-only policy for this checkout's debug binary. It is deliberately
  // not a build or test policy: Cargo, compilers, and package managers need a
  // much broader filesystem and process surface.
  "schema_version": 3,
  "imports": ["minimal"],

  // Landlock restricts filesystem access. Keep keys and YAML configuration in
  // this dedicated directory; do not grant the repository, home directory, or
  // a broad /tmp tree to the service.
  "paths": {
    "ro": [
      "/etc/hosts",
      "/etc/nsswitch.conf",
      "/proc",
      "/projects/vpn/p2p-tunnler/target/debug",
      "/run/systemd/resolve",
      "/tmp/p2p-tunnler-runtime"
    ],
    "rx": [
      "add-exec",
      "/projects/vpn/p2p-tunnler/target/debug",
      "/nix/store/qqiqd3ah10x8hzsif4j1y4xc1miw23nx-glibc-2.42-67/lib",
      "/nix/store/qqiqd3ah10x8hzsif4j1y4xc1miw23nx-glibc-2.42-67/lib64",
      "/nix/store/w2nk3f7prwzpm6h13rfxh8lh46yfdysj-gcc-15.3.0-lib/lib",
      "/nix/store/vbrdc5wgzn0w1zdp10xd2favkjn5fk7y-glibc-2.40-66/lib",
      "/nix/store/vbrdc5wgzn0w1zdp10xd2favkjn5fk7y-glibc-2.40-66/lib64",
      "/nix/store/hmi4qvjrcdvzsing2l56ybcwb6hkmf6y-gcc-15.3.0-libgcc/lib",
      "/nix/store/g7b1jkypxsa9r4642kjcbsmmlvrhb3n8-xgcc-15.3.0-libgcc/lib",
      "/nix/store/y7d4wm0mii5i2yqg2xbrm5lszydw15jq-gcc-14.2.1.20250322-libgcc/lib",
      "/nix/store/rf8hcy6bldxdqc0g6q1dcka1vh47x69s-xgcc-14.2.1.20250322-libgcc/lib",
      "/nix/store/lvnwkc4prm9iscgmil07a2d2fyj2f88y-xgcc-14.2.1.20250322-libgcc/lib",
      "/nix/store/kwqjdj3j4i5lzylzfg7arv8xlf2mahl7-gcc-14.2.1.20250322-lib/lib",
      "/nix/store/v2dh8jc3ywcq7miqkjxn07q2l9pm46zx-nettle-3.10.2/lib",
      "/nix/store/72gsl1zlhbpjml7dz68r7jmhy40q6m6a-simdutf-9.0.0/lib",
      "/nix/store/9jaxb7yp9d9srm23r5s8fil4kmy1kfha-gnutls-3.8.13/lib",
      "/nix/store/69rk620g8mrxb3cygajq3piyyysbbapb-fmt-12.1.0/lib",
      "/nix/store/39jzpf9ray7mxjnlmqbrxlyz0dsz0448-openssl-3.6.3/lib",
      "/nix/store/yss7dszbr0pz3zqym0kf167rh71l870m-openssl-3.4.1/lib",
      "/nix/store/0ww3ms7cac306639f5sqqcjanbzkhrqa-openssl-3.4.1/lib",
      "/nix/store/xh4024h863cbywzs4id9xwmhvfv3bvp4-libargon2-20190702/lib",
      "/nix/store/8pihvbzal3gsb64p4m978md32rwrpxv4-glibc-2.40-66/lib",
      "/nix/store/n26c9r0s2xk3jg0gj8x2xd36pahx1jwh-http-parser-2.9.4/lib",
      "/nix/store/f9hzpd27fi9rqwapvp0ab5zw8p3zdzpw-jsoncpp-1.9.8/lib",
      "/nix/store/y614bwhzdqr0b6q3vrmp1vlqacfwqyql-p11-kit-0.26.2/lib",
      "/nix/store/7svf4fa139ajvhfaxry3smvlbhrnraq1-libidn2-2.3.8/lib",
      "/nix/store/sy2whqnl8z8aakhh0n0sgrflj27hc6in-libunistring-1.4.2/lib",
      "/nix/store/rpn4wbgbhhj6xabhzw12k1p1l7x4hvmv-libtasn1-4.21.0/lib",
      "/nix/store/26c8kfm1q4i2vsx856bzj7whljidvrkg-gmp-with-cxx-6.3.0/lib",
      "/nix/store/9f9kydhbnmsxi8w5wh1x91xjzg757vjl-libffi-3.7.1/lib"
    ],
    "rw": [
      "/dev/null",
      "/dev/urandom",
      "/tmp/p2p-tunnler-runtime"
    ]
  },

  // Keep the schema-v3 defaults: deny abstract Unix-socket communication and
  // cross-scope signals. UDP is intentionally required by this application;
  // current Landlock support cannot restrict UDP destination addresses.
  "scope_escape": ["abstract_unix_socket", "signal"],

  // Default allow is paired with explicit, audited denies and strict
  // filesystem confinement. A default-deny syscall list must be generated
  // from a representative service trace before it can safely replace this.
  "syscalls": {
    "default": "allow",
    "fast_path": [
      { "name": "~socket", "family": "AF_ALG" },
      { "name": "~socket", "type": "SOCK_PACKET" },
      { "name": "~socket", "family": "AF_UNIX" },
      { "name": "~socketpair", "family": "AF_UNIX" },
      "!accept",
      "!add_key",
      "!bpf",
      "!capset",
      "!chroot",
      "!creat",
      "!delete_module",
      "!execveat",
      "!finit_module",
      "!fork",
      "!init_module",
      "!io_uring_setup",
      "!kexec_file_load",
      "!kexec_load",
      "!listen",
      "!mount",
      "!mount_setattr",
      "!perf_event_open",
      "!pidfd_getfd",
      "!pivot_root",
      "!process_vm_readv",
      "!process_vm_writev",
      "!ptrace",
      "!reboot",
      "!removexattr",
      "!setdomainname",
      "!sethostname",
      "!setns",
      "!swapoff",
      "!swapon",
      "!tkill",
      "!umount2",
      "!unshare",
      "!userfaultfd",
      "!vfork",
      { "name": "~fanotify_mark", "events": "FAN_OPEN_PERM" },
      { "name": "~request_key", "callout": "non_null" },
      { "name": "~rt_sigqueueinfo", "info": "non_null" },
      { "name": "~setrlimit", "resource": "RLIMIT_NPROC" },
      { "name": "~setxattr", "flags": "XATTR_CREATE" },
      { "name": "~setxattr", "flags": "XATTR_REPLACE" },
      { "name": "~unlinkat", "entry_type": "directory" }
    ]
  }
}
